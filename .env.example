# Anthropic Claude API 키 — https://console.anthropic.com 에서 발급
# 로컬 개발 시: 이 파일을 .env.local 로 복사하고 값을 채우세요 (.env.local은 git에 올라가지 않습니다)
# 배포 시: Netlify 프로젝트 → Site configuration → Environment variables 에 동일한 이름으로 등록하세요
ANTHROPIC_API_KEY=

# (선택) 사용할 모델. 비워두면 기본값 사용
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Supabase 프로젝트 URL / anon 키 — 상담 신청 DB 저장, 상담 사례 공개 조회에 사용
# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role 키 — 상담 사례 관리자 업로드/삭제 전용 (서버에서만 사용, 절대 노출 금지)
# Supabase 대시보드 → Project Settings → API → service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# 상담 사례 관리자 페이지(/admin/cases) 접근 비밀번호 — 직접 정하세요
ADMIN_PASSWORD=
